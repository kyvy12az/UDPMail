        <dependency><groupId>com.formdev</groupId><artifactId>flatlaf</artifactId></dependency>
        <dependency><groupId>com.formdev</groupId><artifactId>flatlaf-extras</artifactId></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
